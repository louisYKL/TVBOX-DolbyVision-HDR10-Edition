<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_640"
        android:layout_height="@dimen/vs_520"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_bg_main"
        android:orientation="vertical"
        android:padding="@dimen/vs_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_54"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvExternalSubtitleTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="选择外挂字幕"
                android:textColor="@color/apple_tv_text_primary"
                android:textSize="@dimen/ts_24"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnExternalSubtitleLocal"
                android:layout_width="@dimen/vs_100"
                android:layout_height="match_parent"
                android:background="@drawable/button_dialog_main"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="本地"
                android:textColor="@color/apple_tv_text_primary"
                android:textSize="@dimen/ts_18" />

            <TextView
                android:id="@+id/btnExternalSubtitleWebDav"
                android:layout_width="@dimen/vs_120"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/vs_8"
                android:background="@drawable/button_dialog_main"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="WebDAV"
                android:textColor="@color/apple_tv_text_primary"
                android:textSize="@dimen/ts_18" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvExternalSubtitlePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_6"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/apple_tv_text_secondary"
            android:textSize="@dimen/ts_16" />

        <ProgressBar
            android:id="@+id/progressExternalSubtitle"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_3"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvExternalSubtitleStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:gravity="center"
            android:textColor="@color/apple_tv_text_secondary"
            android:textSize="@dimen/ts_18"
            android:visibility="gone" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/rvExternalSubtitleFiles"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/vs_8"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/vs_6" />

    </LinearLayout>
</FrameLayout>
