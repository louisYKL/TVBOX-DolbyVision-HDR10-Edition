<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/vs_76"
    android:layout_marginBottom="@dimen/vs_8"
    android:background="@drawable/shape_setting_model_focus"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/vs_18"
    android:paddingEnd="@dimen/vs_22">

    <ImageView
        android:id="@+id/ivEntryIcon"
        android:layout_width="@dimen/vs_36"
        android:layout_height="@dimen/vs_36"
        android:alpha="0.86" />

    <TextView
        android:id="@+id/tvEntryName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vs_14"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textColor="@color/apple_tv_text_primary"
        android:textSize="@dimen/ts_22" />

    <TextView
        android:id="@+id/tvEntryDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/apple_tv_text_secondary"
        android:textSize="@dimen/ts_16" />
</LinearLayout>
