<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_apple_tv_shell"
    android:orientation="vertical"
    android:paddingStart="@dimen/vs_40"
    android:paddingTop="@dimen/vs_28"
    android:paddingEnd="@dimen/vs_40"
    android:paddingBottom="@dimen/vs_28">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_64"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnWebDavBack"
            android:layout_width="@dimen/vs_100"
            android:layout_height="match_parent"
            android:background="@drawable/shape_setting_model_focus"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="返回"
            android:textColor="@color/apple_tv_text_primary"
            android:textSize="@dimen/ts_20" />

        <TextView
            android:id="@+id/tvWebDavTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_20"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="WebDAV"
            android:textColor="@color/apple_tv_text_primary"
            android:textSize="@dimen/ts_30"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnWebDavSettings"
            android:layout_width="@dimen/vs_110"
            android:layout_height="match_parent"
            android:background="@drawable/shape_setting_model_focus"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="设置"
            android:textColor="@color/apple_tv_text_primary"
            android:textSize="@dimen/ts_20" />

        <TextView
            android:id="@+id/btnWebDavRefresh"
            android:layout_width="@dimen/vs_110"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/vs_10"
            android:background="@drawable/shape_setting_model_focus"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="刷新"
            android:textColor="@color/apple_tv_text_primary"
            android:textSize="@dimen/ts_20" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvWebDavPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_14"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textColor="@color/apple_tv_text_secondary"
        android:textSize="@dimen/ts_16" />

    <ProgressBar
        android:id="@+id/progressWebDav"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_3"
        android:layout_marginTop="@dimen/vs_12"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvWebDavStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_18"
        android:gravity="center"
        android:textColor="@color/apple_tv_text_secondary"
        android:textSize="@dimen/ts_20"
        android:visibility="gone" />

    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/rvWebDavEntries"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vs_12"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/vs_10" />
</LinearLayout>
